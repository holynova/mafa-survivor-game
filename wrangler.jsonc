{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "holynova-github-io",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "xiaosang.cc/mafa-survivor-game",
      "zone_id": "a9ae8ed6c9a473e6c79daa58b29e8b12"
    },
    {
      "pattern": "xiaosang.cc/mafa-survivor-game/*",
      "zone_id": "a9ae8ed6c9a473e6c79daa58b29e8b12"
    }
  ]
}
